{
  // Worker deployment of whydrive.co.uk (static assets + API). Custom domains make Cloudflare
  // create the DNS records for whydrive.co.uk and www.whydrive.co.uk automatically.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whydrive-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "whydrive.co.uk", "custom_domain": true },
    { "pattern": "www.whydrive.co.uk", "custom_domain": true }
  ],
  "vars": {
    // Shown when the form cannot send. Switch back to driver@whydrive.co.uk once that inbox receives mail.
    "FALLBACK_EMAIL": "support@vamalio.com",
    // SHA-256 of the /qr-stats password (the password itself is not stored anywhere in the repo).
    "QR_STATS_PASSWORD_SHA256": "283e5a9c507dc52cf0ea46254890736a7308e72b1d1f21a75469a578d19789af"
  },
  // QR scan counts (worker/qr-stats.js). Cloudflare creates the storage on the first deploy.
  "durable_objects": { "bindings": [{ "name": "QR_STATS", "class_name": "QrStats" }] },
  "migrations": [{ "tag": "qr-stats-v1", "new_sqlite_classes": ["QrStats"] }],
  "workers_dev": true,
  "observability": { "enabled": true }
}
