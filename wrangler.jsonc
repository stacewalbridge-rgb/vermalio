{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vermalio",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "BTO_PRINT_SPREADS",
      "id": "4935699f8f314459950e7e2c8c16fa77"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BTO_ORDER_STORE",
        "class_name": "BtoOrderStore"
      }
    ]
  },
  "exports": {
    "BtoOrderStore": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
